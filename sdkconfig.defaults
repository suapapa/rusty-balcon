# Rust on ESP32-H2 std project configuration
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=5
CONFIG_BT_NIMBLE_MAX_CCCDS=5

# Match ESP32-H2 module flash (boot log reports 4MB).
# Mismatch with a leftover bootloader/partition table causes
# mmu_hal_map_region (vaddr % page_size == 0) asserts at app_main.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_MMU_PAGE_SIZE_32KB=y

# Increase main task stack size for UI/display logic
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Optimization
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Power Management
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_HZ=100
